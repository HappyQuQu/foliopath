# Copy to a private ai.env; fill every required value before running Compose.
# No real digest, host path, model license or quality approval is invented here.
FOLIOPATH_IMAGE=
FOLIOPATH_AI_IMAGE=
FOLIOPATH_LIBRARY_PATH=
FOLIOPATH_DATA_PATH=
FOLIOPATH_MODEL_CACHE_PATH=
# Single-line JSON, quoted with single quotes in this env file:
# {"origin":"http://machine-learning:3003","identity":<offline image_identity object>,"model_bytes":<actual bytes>,"license_id":"<reviewed identifier>"}
# Optional face object follows docs/deployment.md; never copy test thresholds.
FOLIOPATH_AI_DEPLOYMENT=
FOLIOPATH_BIND_ADDRESS=127.0.0.1
FOLIOPATH_PORT=8080
TZ=UTC
