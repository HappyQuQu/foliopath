# Transport-only test image, not a release/deployment unit. No app/media/model mount.
FROM golang:1.26.5-trixie@sha256:4ee9ffa999b4583ce281939cdff828763083610292f252279a0cee77473bd9a7 AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download
COPY internal ./internal
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=1 go test -race -c -o /out/ocr.test ./internal/ocr \
    && CGO_ENABLED=1 go test -race -c -o /out/remoteml.test ./internal/inference/remoteml
FROM debian:trixie-slim@sha256:020c0d20b9880058cbe785a9db107156c3c75c2ac944a6aa7ab59f2add76a7bd
COPY --from=build /out/ /tests/
ENTRYPOINT ["sh", "-c", "/tests/ocr.test -test.v -test.timeout=60s && /tests/remoteml.test -test.v -test.timeout=60s"]
