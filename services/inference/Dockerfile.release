# Native packaging of the deployed multilingual/photo-tag/OCR profile.
# BASE in ocr_contract.py binds the frozen compatibility generation, not this FROM.
FROM ghcr.io/immich-app/immich-machine-learning:v3.1.0@sha256:5a0839dc5303cd7215bcd2180a26aed3af41675aefb3e75e5157e9f10ad16e6e
COPY ["services/inference/cache_snapshot.py","/opt/foliopath-inference/cache_snapshot.py"]
COPY ["services/inference/face_contract.py","/opt/foliopath-inference/face_contract.py"]
COPY ["services/inference/image_identity.py","/opt/foliopath-inference/image_identity.py"]
COPY ["services/inference/inference_worker.py","/opt/foliopath-inference/inference_worker.py"]
COPY ["services/inference/multilingual_contract.py","/opt/foliopath-inference/multilingual_contract.py"]
COPY ["services/inference/multilingual_server.py","/opt/foliopath-inference/multilingual_server.py"]
COPY ["services/inference/multilingual_worker.py","/opt/foliopath-inference/multilingual_worker.py"]
COPY ["services/inference/ocr_contract.py","/opt/foliopath-inference/ocr_contract.py"]
COPY ["services/inference/ocr_engine.py","/opt/foliopath-inference/ocr_engine.py"]
COPY ["services/inference/ocr_native_tests.py","/opt/foliopath-inference/ocr_native_tests.py"]
COPY ["services/inference/ocr_runtime.py","/opt/foliopath-inference/ocr_runtime.py"]
COPY ["services/inference/ocr_scheduler.py","/opt/foliopath-inference/ocr_scheduler.py"]
COPY ["services/inference/ocr_server.py","/opt/foliopath-inference/ocr_server.py"]
COPY ["services/inference/ocr_tests.py","/opt/foliopath-inference/ocr_tests.py"]
COPY ["services/inference/ocr_worker.py","/opt/foliopath-inference/ocr_worker.py"]
COPY ["services/inference/photo_policy.py","/opt/foliopath-inference/photo_policy.py"]
COPY ["services/inference/photo_runtime.py","/opt/foliopath-inference/photo_runtime.py"]
COPY ["services/inference/photo_server.py","/opt/foliopath-inference/photo_server.py"]
COPY ["services/inference/photo_worker.py","/opt/foliopath-inference/photo_worker.py"]
COPY ["services/inference/probe_face.py","/opt/foliopath-inference/probe_face.py"]
COPY ["services/inference/runtime_entry.py","/opt/foliopath-inference/runtime_entry.py"]
COPY ["services/inference/runtime_manifest.py","/opt/foliopath-inference/runtime_manifest.py"]
COPY ["services/inference/scheduler.py","/opt/foliopath-inference/scheduler.py"]
COPY ["services/inference/server.py","/opt/foliopath-inference/server.py"]
COPY ["services/inference/tag_contract.py","/opt/foliopath-inference/tag_contract.py"]
COPY ["services/inference/test_face.py","/opt/foliopath-inference/test_face.py"]
COPY ["services/inference/test_runtime_manifest.py","/opt/foliopath-inference/test_runtime_manifest.py"]
COPY ["services/inference/test_scheduler.py","/opt/foliopath-inference/test_scheduler.py"]
COPY ["services/inference/test_service.py","/opt/foliopath-inference/test_service.py"]
COPY ["services/inference/test_tag.py","/opt/foliopath-inference/test_tag.py"]
COPY ["services/inference/test_tcp_disconnect.py","/opt/foliopath-inference/test_tcp_disconnect.py"]
COPY ["services/inference/ocr-input.generated.json","/opt/foliopath-inference/ocr-input.generated.json"]
COPY ["services/inference/ocr-manifest.json","/opt/foliopath-inference/ocr-manifest.json"]
COPY ["services/inference/ocr-output.generated.json","/opt/foliopath-inference/ocr-output.generated.json"]
COPY ["spikes/int001-remote-ml/cache-baseline.json","/opt/foliopath-inference/local-baseline.json"]
COPY ["spikes/int001-remote-ml/multilingual/cache-baseline.json","/opt/foliopath-inference/multilingual-manifest.json"]
COPY ["internal/curation/tag_categories.json","/opt/foliopath-inference/photo_categories.json"]
COPY ["internal/ocr/conformance.json","/opt/foliopath-inference/ocr-conformance.json"]
ENV PYTHONPATH=/opt/foliopath-inference
RUN python -c 'import json,pathlib; p=pathlib.Path("/opt/foliopath-inference"); entries=json.loads((p/"local-baseline.json").read_text()); prefixes=("clip/ViT-B-32__openai/", "facial-recognition/buffalo_l/"); (p/"cache-manifest.json").write_text(json.dumps([e for e in entries if e["path"].startswith(prefixes)],sort_keys=True,separators=(",",":")))'
RUN python -c 'import json,pathlib,tag_contract; pathlib.Path("/opt/foliopath-inference/tag-manifest.json").write_text(json.dumps(tag_contract.MANIFEST,sort_keys=True,separators=(",",":")))'
RUN python -m ocr_contract > /opt/foliopath-inference/ocr-identity.json
CMD ["python", "-m", "ocr_runtime"]
