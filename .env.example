# No stable image exists yet. For source-candidate evaluation use the explicit local
# tag documented in README.md. A release deployment must use its version or digest.
# Never deploy a floating latest tag.
FOLIOPATH_IMAGE=ghcr.io/HappyQuQu/foliopath:VERSION

# One host media presentation root; descendants must not contain nested mounts.
FOLIOPATH_LIBRARY_PATH=/mnt/photos

# Local filesystem owned by UID/GID 65532. SMB/NFS is not supported for active data.
FOLIOPATH_DATA_PATH=./foliopath-data

# Compose-only host bind address, port, and container timezone.
# 0.0.0.0 supports authenticated HTTP access from a trusted LAN. Use 127.0.0.1
# when an external reverse proxy on the host owns public TLS.
FOLIOPATH_BIND_ADDRESS=0.0.0.0
FOLIOPATH_PORT=8080
TZ=UTC
