# Optional compose.yaml overrides. No .env file is required for the defaults.
# Pin a version or digest for controlled upgrades.
FOLIOPATH_IMAGE=evanqu/foliopath:latest

# One host media presentation root; descendants must not contain nested mounts.
FOLIOPATH_LIBRARY_PATH=/mnt/photos

# Local filesystem writable by the root runtime. SMB/NFS is not supported for active data.
FOLIOPATH_DATA_PATH=./data

# Compose-only host bind address, port, and timezone.
# 0.0.0.0 supports authenticated HTTP access from a trusted LAN. Use 127.0.0.1
# when an external reverse proxy on the host owns public TLS.
FOLIOPATH_BIND_ADDRESS=0.0.0.0
FOLIOPATH_PORT=8080
TZ=UTC
